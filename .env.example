# Build-time flags only. Never put secrets here: everything prefixed with VITE_ ends up in the
# public JavaScript bundle. v1 has no runtime secrets at all.

# dev | test | prod — shown in the UI footer outside prod, used to pick logging verbosity.
VITE_APP_ENV=dev

# Opt-in vision-model recognizer (ADR-5). Keep false: when true the build extends the CSP
# connect-src with the provider's API origin and shows the consent dialog in the import wizard.
VITE_ENABLE_VISION=false
