{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":semanticCommits",
    ":semanticCommitScope(deps)"
  ],
  "rangeStrategy": "pin",
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Warsaw",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Group dev tooling updates into one PR.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev tooling"
    },
    {
      "description": "Playwright packages must move together (browser versions are coupled).",
      "matchPackageNames": ["@playwright/test", "playwright", "playwright-core"],
      "groupName": "playwright"
    },
    {
      "description": "typescript-eslint pins the supported TypeScript range; update TypeScript majors manually.",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": { "enabled": true, "labels": ["security"] }
}
